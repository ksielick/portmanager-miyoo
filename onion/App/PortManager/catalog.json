{
  "$schema": "./catalog.schema.json",
  "version": 0,
  "sources": [
    {
      "name": "MiyooMini-Ports",
      "url": "https://raw.githubusercontent.com/Producdevity/MiyooMini-Ports/master/ports.json",
      "use": "where names and statuses of entries below were checked, by hand; Port Manager doesn't read this"
    }
