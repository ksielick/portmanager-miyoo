  "ports": [
    {
      "id": "hexen2",
      "name": "Hexen II",
      "category": "FPS",
      "status": "playable",
      "repo": "cacuracaptors/uhexen2-miyoomini",
      "asset": "^HexenII-miyoomini-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/Hexen2",
      "data": {
        "required": [
          "data1/pak0.pak",
          "data1/pak1.pak"
        ],
        "optional": [
          "data1/music/"
        ]
      },
      "get": "Hexen II, GOG version. Copy everything inside its data1 folder into Roms/PORTS/Games/Hexen2/data1/. Music (optional): its music folder (Track02.ogg to Track17.ogg) into Roms/PORTS/Games/Hexen2/data1/music/. File name case doesn't matter."
    },
    {
      "id": "skifree",
      "name": "SkiFree",
      "category": "Arcade",
      "status": "playable",
      "repo": "cacuracaptors/skifree-miyoomini",
      "asset": "^SkiFree-Miyoo-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/SkiFree",
      "data": null
    },
    {
      "id": "tombraider",
      "name": "Tomb Raider",
      "category": "Platform",
      "status": "playable",
      "repo": "cacuracaptors/OpenLara-miyoomini",
      "asset": "^OpenLara-Miyoo-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/OpenLara",
      "data": {
        "required_any": [
          "Tomb Raider 1/GAME.GOG",
          "Tomb Raider 1/DATA/"
        ],
        "optional": [
          "Tomb Raider 1/02.mp3"
        ]
      },
      "get": "Tomb Raider 1+2+3, GOG version (https://www.gog.com/en/game/tomb_raider_123). From its Tomb Raider 1 folder (GOG Galaxy: settings next to Play > Manage installation > Show folder) copy GAME.GOG and, for music (optional), 02.mp3 to 10.mp3 into Roms/PORTS/Games/OpenLara/Tomb Raider 1/. The first start unpacks GAME.GOG into DATA/ and FMV/ (about a minute, needs ~170 MB free) and deletes it."
    },
    {
      "id": "pinball",
      "name": "3D Pinball Space Cadet",
      "category": "Arcade",
      "status": "playable",
      "repo": "cacuracaptors/spacecadetpinball-miyoomini",
      "asset": "^Pinball-Miyoo-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/Pinball",
      "data": {
        "required": [
          "PINBALL.DAT",
          "FONT.DAT",
          "SOUND*.WAV"
        ],
        "optional": [
          "PINBALL.MID"
        ]
      },
      "get": "3D Pinball for Windows - Space Cadet, from your own Windows installation (Windows XP and earlier shipped it). Copy PINBALL.DAT, FONT.DAT, all SOUND*.WAV and, for music (optional), PINBALL.MID into Roms/PORTS/Games/Pinball/. The first start converts the music (a few minutes, once)."
    },
    {
      "id": "fallout",
      "name": "Fallout",
      "category": "RPG",
      "status": "playable",
      "repo": "cacuracaptors/fallout1-ce-miyoomini",
      "asset": "^Fallout1-Miyoo-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/Fallout",
      "data": {
        "required": [
          "MASTER.DAT",
          "CRITTER.DAT",
          "data/"
        ]
      },
      "get": "Fallout, GOG or Steam version. Copy MASTER.DAT, CRITTER.DAT and the data folder into Roms/PORTS/Games/Fallout/. Don't copy fallout.cfg from the PC (delete it if it's there): the game writes its own."
    },
    {
      "id": "fallout2",
      "name": "Fallout 2",
      "category": "RPG",
      "status": "playable",
      "repo": "cacuracaptors/fallout2-ce-miyoomini",
      "asset": "^Fallout2-Miyoo-.*\\.zip$",
      "layout": "sdcard-root",
      "dir": "Roms/PORTS/Games/Fallout 2",
      "data": {
        "required": [
          "master.dat",
          "critter.dat"
        ],
        "optional": [
          "data/"
        ]
      },
      "get": "Fallout 2, GOG or Steam version. Copy master.dat, critter.dat and the data folder (if your installation has one) into Roms/PORTS/Games/Fallout 2/. Don't copy fallout2.cfg from the PC (delete it if it's there): the game writes its own. The Restoration Project mod works too: see the port's README."
    },
