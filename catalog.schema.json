{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ksielick/portmanager-miyoo/main/catalog.schema.json",
  "title": "Port Manager catalog",
  "description": "catalog.json and catalog.local.json; the meaning of each field is in docs/CATALOG.md. Port Manager also refuses entries whose paths leave the game folder.",
  "type": "object",
  "required": ["ports"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "integer"},
    "sources": {
      "type": "array",
      "description": "Where entries were checked, by hand; Port Manager doesn't read this.",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "use": {"type": "string"}
        }
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/port"}
    }
  },
  "definitions": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\](?!.*\\.\\.)[^\\\\]*$",
      "description": "A path inside the game folder: no leading '/', no '..', no backslashes. Case-insensitive on the card, '*' allowed, a trailing '/' means a folder."
    },
    "relpaths": {
      "type": "array",
      "items": {"$ref": "#/definitions/relpath"}
    },
    "port": {
      "type": "object",
      "required": ["id", "name", "category", "repo", "asset", "layout", "dir", "data"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Unique, lowercase; the key of what's installed, so never change it."},
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$", "description": "Display name, also the shortcut's and picture's file name."},
        "category": {
          "enum": ["Action", "Arcade", "FPS", "Platform", "Puzzle games", "Racing", "Reflex", "RPG", "Simulation", "Strategy"],
          "description": "The Shortcuts subfolder in Onion's Ports list. A new one needs the owner's OK, then add it here."
        },
        "status": {
          "enum": ["playable", "experimental", "prerelease"],
          "description": "playable: runs well. experimental: runs, but rough (shown on the game's page). prerelease: the author calls it a test version (shown on the game's page)."
        },
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "owner/name on GitHub; the owner is shown as the port's author."},
        "asset": {"type": ["string", "null"], "minLength": 1, "description": "Regex for the release file; null = no releases yet."},
        "layout": {"enum": ["sdcard-root", "app-to-ports"]},
        "skip": {"$ref": "#/definitions/relpaths"},
        "dir": {"type": "string", "pattern": "^Roms/PORTS/Games/[^/\\\\](?!.*\\.\\.)[^\\\\]*$"},
        "backup": {"$ref": "#/definitions/relpaths"},
        "data": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "required": {"$ref": "#/definitions/relpaths"},
            "required_any": {"$ref": "#/definitions/relpaths"},
            "optional": {"$ref": "#/definitions/relpaths"},
            "forbidden": {"$ref": "#/definitions/relpaths"},
            "built": {"$ref": "#/definitions/relpaths"},
            "rom": {
              "type": "object",
              "required": ["name", "dest"],
              "additionalProperties": false,
              "properties": {
                "system": {"type": "string"},
                "name": {"type": "string"},
                "formats": {"type": "array", "items": {"type": "string"}},
                "dest": {"$ref": "#/definitions/relpath"},
                "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
                "size": {"type": "integer", "minimum": 1}
              }
            },
            "disc": {
              "type": "object",
              "required": ["name", "where"],
              "additionalProperties": false,
              "properties": {
                "system": {"type": "string"},
                "name": {"type": "string"},
                "where": {"type": "string"},
                "formats": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "shortcut": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "GameDataFile": {"$ref": "#/definitions/relpath"},
            "run": {"$ref": "#/definitions/relpath"}
          }
        },
        "get": {"type": "string", "minLength": 1, "description": "Instructions for the player: which files, from which version of the game, where they go."}
      }
    }
  }
}
