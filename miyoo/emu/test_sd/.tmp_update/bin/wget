#!/bin/sh
# EMU_OFFLINE=1 (scenario "offline"): no network, as with Wi-Fi off
[ -n "$EMU_OFFLINE" ] && exit 1
REAL_WGET=""
for p in /usr/bin/wget /bin/wget; do
	if [ -x "$p" ]; then
		REAL_WGET="$p"
		break
	fi
done
[ -z "$REAL_WGET" ] && REAL_WGET="wget"

if [ -n "$GITHUB_TOKEN" ] && echo "$*" | grep -q "api.github.com"; then
	exec "$REAL_WGET" --header="Authorization: Bearer $GITHUB_TOKEN" "$@"
else
	exec "$REAL_WGET" "$@"
fi
