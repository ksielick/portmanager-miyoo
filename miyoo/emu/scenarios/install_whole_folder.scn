# A new game folder goes in whole (Frozen Bubble, 3300 files), and its shortcut, shipped only
# as .notfound, goes in as .port in our category
press 1 X        # all ports, A-Z
press 2 DOWN / press 3 DOWN / press 4 DOWN / press 5 DOWN / press 6 DOWN / press 7 DOWN
press 8 DOWN / press 9 DOWN / press 10 DOWN
press 11 A       # details: Frozen Bubble
press 12 A       # check
press 13 A       # install
press 14 A       # yes
press 15 B       # result
press 16 B       # details
press 17 B       # all ports
press 18 B       # exit
timeout 900
shots every:1
min_frames 14
assert_exists "Roms/PORTS/Games/Frozen Bubble/frozen-bubble-sdl2"
assert_exists "Roms/PORTS/Games/Frozen Bubble/.pm_manifest"
assert_exists "Roms/PORTS/Shortcuts/Puzzle games/Frozen Bubble.port"
assert_not_exists "Roms/PORTS/Shortcuts/Puzzle games/Frozen Bubble.notfound"
assert_not_exists "Roms/PORTS/Shortcuts/Puzzle/Frozen Bubble.port"
assert_not_exists .pm_work/stage
assert_log_order "Frozen Bubble: unpacking..." "Frozen Bubble: moved the new folder in whole" "Frozen Bubble: installed v"
