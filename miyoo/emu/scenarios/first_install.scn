# A new player's first run: empty list, all ports (A-Z), F-Zero X installed, back on the list
rm Roms/PORTS/Games
rm Roms/PORTS/Shortcuts
press 1 X        # all ports, A-Z: 3D Pinball, Banjo-Kazooie, C-Dogs, Cave Story, Diddy Kong Racing, Dinothawr, F-Zero X
press 2 DOWN / press 3 DOWN / press 4 DOWN / press 5 DOWN / press 6 DOWN / press 7 DOWN
press 8 A        # details: F-Zero X
press 9 A        # check
press 10 A       # install
press 11 A       # yes
press 12 B       # result
press 13 B       # details
press 14 B       # all ports
press 15 B       # exit
shots every:1
min_frames 12
assert_exists Roms/PORTS/Games/FZeroX/fzerox
assert_exists "Roms/PORTS/Shortcuts/Racing/F-Zero X.port"
assert_log "F-Zero X: installed "
