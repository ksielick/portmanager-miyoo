# A new player's first run: empty list, all ports, F-Zero X installed, back on the list
rm Roms/PORTS/Games
rm Roms/PORTS/Shortcuts
press 1 X        # all ports
press 2 DOWN / press 3 DOWN / press 4 DOWN / press 5 DOWN / press 6 DOWN / press 7 DOWN / press 8 DOWN
press 9 DOWN / press 10 DOWN / press 11 DOWN / press 12 DOWN / press 13 DOWN / press 14 DOWN / press 15 DOWN
press 16 A       # details: F-Zero X
press 17 A       # check
press 18 A       # install
press 19 A       # yes
press 20 B       # result
press 21 B       # details
press 22 B       # all ports
press 23 B       # exit
shots every:1
min_frames 20
assert_exists Roms/PORTS/Games/FZeroX/fzerox
assert_exists "Roms/PORTS/Shortcuts/Racing/F-Zero X.port"
assert_log "F-Zero X: installed "
