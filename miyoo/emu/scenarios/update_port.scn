# Update all from check results screen with Start
press 1 Y
press 2 START
press 3 A
shots 1 2 4 every:10
min_frames 4
nonblank 1 2
assert_exists Backups/PortManager
assert_exists Roms/PORTS/Games/DiddyKongRacing/.pm_version
assert_not_contains Roms/PORTS/Games/DiddyKongRacing/.miyoo64_version 1.1.2   # the card's version; the latest changes with each miyoo64 release
assert_log_not "SkiFree: 1.0.1 -> v1.0.1"
assert_log_not "Tomb Raider: 1.0.6 -> v1.0.6"
